generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGER
  DEVELOPER
  TESTER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReqStatus {
  DRAFT
  APPROVED
  IMPLEMENTED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskType {
  STORY
  TASK
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TestStatus {
  NOT_RUN
  PASSED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Member[]
  assignedTasks Task[] @relation("TaskAssignee")
  reportedBugs  Bug[]  @relation("BugReporter")
  assignedBugs  Bug[]  @relation("BugAssignee")
  activities    Activity[]
  docs          Doc[]
}

model Project {
  id            String   @id @default(cuid())
  name          String
  key           String   @unique
  description   String   @default("")
  repoOwner     String?
  repoName      String?
  githubToken   String?
  webhookSecret String   @default(uuid())
  createdAt     DateTime @default(now())

  members      Member[]
  requirements Requirement[]
  sprints      Sprint[]
  tasks        Task[]
  bugs         Bug[]
  docs         Doc[]
  testCases    TestCase[]
  activities   Activity[]
  runs         PipelineRun[]
}

model Member {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      Role     @default(DEVELOPER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Requirement {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String    @default("")
  priority    Priority  @default(MEDIUM)
  status      ReqStatus @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  testCases TestCase[]

  @@index([projectId])
}

model Sprint {
  id              String       @id @default(cuid())
  projectId       String
  name            String
  goal            String       @default("")
  startDate       DateTime
  endDate         DateTime
  status          SprintStatus @default(PLANNED)
  committedPoints Int          @default(0)
  completedPoints Int          @default(0)
  createdAt       DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
}

model Task {
  id            String     @id @default(cuid())
  projectId     String
  number        Int
  title         String
  description   String     @default("")
  type          TaskType   @default(TASK)
  priority      Priority   @default(MEDIUM)
  status        TaskStatus @default(BACKLOG)
  points        Int?
  position      Float      @default(0)
  assigneeId    String?
  sprintId      String?
  requirementId String?
  gitBranch     String?
  prUrl         String?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sprint      Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  bugs        Bug[]

  @@unique([projectId, number])
  @@index([projectId, status])
  @@index([sprintId])
  @@index([assigneeId])
}

model Bug {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String    @default("")
  severity    Priority  @default(MEDIUM)
  status      BugStatus @default(OPEN)
  reporterId  String?
  assigneeId  String?
  taskId      String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reporter User?   @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee User?   @relation("BugAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  task     Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
}

model Doc {
  id        String   @id @default(cuid())
  projectId String
  title     String
  content   String   @default("")
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model TestCase {
  id            String     @id @default(cuid())
  projectId     String
  requirementId String?
  title         String
  steps         String     @default("")
  expected      String     @default("")
  status        TestStatus @default(NOT_RUN)
  aiGenerated   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model Activity {
  id        String   @id @default(cuid())
  projectId String
  userId    String?
  action    String
  entity    String
  entityId  String?
  message   String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model PipelineRun {
  id          String   @id @default(cuid())
  projectId   String
  githubRunId String
  name        String
  branch      String?
  commitSha   String?
  status      String
  conclusion  String?
  url         String?
  createdAt   DateTime

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, githubRunId])
  @@index([projectId, createdAt])
}
